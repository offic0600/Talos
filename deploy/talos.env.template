# /etc/hermes/talos.env — shared environment for all Talos processes
#
# Copy this file to /etc/hermes/talos.env and fill in real values.
# DO NOT commit real values to the repository.
#
# Permissions: chmod 600 /etc/hermes/talos.env, owned by root:talos

# ── Kanban database ──────────────────────────────────────────
# Canonical path (HLD §11). The executor, CLI, and (future) scheduler
# all load this variable so they see the same database.
HERMES_KANBAN_DB=/home/talos/.hermes/kanban/kanban.db

# ── Elasticsearch ─────────────────────────────────────────────
# The trace forwarder sends JSONL to this URL.
TALOS_ES_URL=http://127.0.0.1:9200

# ── GitLab ────────────────────────────────────────────────────
# Base URL of the GitLab instance (CE 16.3+).
# Replace with your own GitLab URL.
TALOS_GITLAB_URL=https://gitlab.example.com

# Admin token used to mint per-task project access tokens (§9).
# ⚠️ Transition period: this is a personal token. Replace with a
#    dedicated bot account after second-batch acceptance (定稿结论 5).
#    Must NOT appear in any committed file or log output.
TALOS_GITLAB_ADMIN_TOKEN=

# Comma-separated list of GitLab project IDs for orphan token cleanup.
# TALOS_GITLAB_PROJECT_IDS=1,2,3

# Git commit author email for worker-created commits.
# TALOS_GIT_AUTHOR_EMAIL=talos-worker@localhost

# ── PYTHONPATH / hermes-agent install ──────────────────────────
# The executor imports from `hermes_cli` (the hermes-agent package).
# Install hermes-agent in editable mode so imports resolve:
#   pip install -e ~/.hermes/hermes-agent
# If running in a venv, activate it first, then run the install above.
# The systemd unit (talos-executor.service) sets PYTHONPATH to include
# both the venv site-packages and the hermes-agent source tree so that
# `from hermes_cli import ...` works at runtime.
# PYTHONPATH is typically set by the systemd unit; override here only
# if you need a non-default value.
# PYTHONPATH=/opt/talos:/home/talos/.hermes/hermes-agent

# ── Model / inference provider ────────────────────────────────
# The worker container needs to know which LLM to call. These are read
# by _generate_container_config() to render deploy/container-config.template.yaml.
# The actual API key is passed via the _build_env whitelist (API_SERVER_KEY etc.),
# NOT through this template — so no key value ever enters config.yaml.
TALOS_MODEL=GLM-5
TALOS_MODEL_PROVIDER=custom:your-provider
TALOS_MODEL_PROVIDER_NAME=your-provider
TALOS_MODEL_BASE_URL=https://your-inference-endpoint/v1
# Name of the env var that holds the API key (NOT the key value itself).
TALOS_MODEL_KEY_ENV=API_SERVER_KEY

# ── Container NO_PROXY ────────────────────────────────────────
# Docker Desktop intercepts container HTTPS traffic via a built-in proxy
# (http.docker.internal:3128).  That proxy breaks TLS to internal IPs,
# causing SSLEOFError when the worker tries to reach an on-prem model
# gateway.  TALOS_NO_PROXY lists hosts that should bypass the proxy,
# and is passed to the container as NO_PROXY / no_proxy at spawn time.
# Comma-separated, e.g.: gitlab.example.com,inference.example.com,10.0.0.0/8
TALOS_NO_PROXY=

# ── Host forwarding for VPN-internal services ────────────────
# Docker Desktop on macOS runs containers in a Linux VM that cannot access
# the host's VPN interfaces.  When the model gateway (or GitLab) is on an
# internal network only reachable via host VPN, set up a TCP forwarder on
# the host (e.g. python3 /path/to/forwarder.py) and list it here.
#
# Format: hostname:host.docker.internal:forwarder_port
# The executor adds --add-host hostname:<host_ip> to docker run, so the
# container resolves the hostname to the Docker host IP and connects to
# forwarder_port, where the forwarder bridges to the real service.
#
# Example: inference.example.com:host.docker.internal:9443
TALOS_HOST_FORWARD=

# ── Optional: trace forwarder tuning ──────────────────────────
# FORWARD_INTERVAL=10
# FORWARD_BATCH=200
# TRACE_STAGING=/home/talos/.hermes/trace/staging
# TRACE_ARCHIVE=/home/talos/.hermes/trace/archived
